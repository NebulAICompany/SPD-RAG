# ─────────────────────────────────────────────────
# SPD-RAG  —  Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.
# ─────────────────────────────────────────────────

# Google Gemini  (comma-separated for key rotation)
GOOGLE_API_KEYS=
# or single key:
# GOOGLE_API_KEY=

# OpenAI  (used for GPT judge in benchmarks)
OPENAI_API_KEY=

# Cohere  (embeddings & reranking)
COHERE_API_KEY=

# Qdrant  (vector database — leave empty for local file-based storage)
# QDRANT_URL=http://localhost:6333

# LangSmith  (optional, for tracing)
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=spd-rag
